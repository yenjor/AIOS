# Server-only LiteLLM Proxy configuration for the technical-design Capability.
AIOS_LITELLM_BASE_URL=http://127.0.0.1:4000
AIOS_LITELLM_TECHNICAL_DESIGN_MODEL_ALIAS=aios-technical-design

# Optional when the local proxy does not require a virtual key.
# Never expose this value through NEXT_PUBLIC_* variables.
AIOS_LITELLM_API_KEY=
